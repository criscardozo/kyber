#!/usr/bin/env bash
# What has to be true before anything leaves this machine.
#
# This exists because of how the checks were being run before it: by hand, in
# the right order, every time — which worked all the way up to the commit whose
# message described an edit that had failed its own assertion. The verification
# had happened; it just was not what the push depended on. A rule you can
# recite still depends on remembering it at the one moment you do not.
#
# Kept to what is fast, for a reason measured rather than assumed: a hook
# nobody waits for is one that gets `--no-verify`. Both checks finish in under
# a second, because kyber installs nothing.
#
# What is NOT here, and the reason is the point: the grep that proves this tree
# names no consumer. The first version of this hook ran it, and it rejected the
# very commit that installed it — because to grep for a consumer's project ids
# and ports, the hook had to CONTAIN them, and this repo may not. The guard
# refused its own author under its own rule, on its first run. That check
# belongs to each consumer, holding its own list, which is what the README has
# said all along; there is no version of it that can live here.
#
# Install once per clone:  git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# Through `npm run check`, not by repeating its file list. The list lived in
# both places and nothing coupled them: add a directory and you have to
# remember two, which is the duplication this whole repo exists to remove,
# sitting in its own guard. Found when a consumer noticed two of ITS sweeps
# had drifted apart the same way.
#
# `check` no longer enumerates directories either, for the same reason one step
# down: it listed four, and `firebase/` was not one of them, so a tracked .mjs
# went unparsed for as long as it existed — the old command ran green over a
# deliberately broken copy of it. The file set now comes from `git ls-files`,
# which includes this hook.
echo "pre-push: syntax"
npm run -s check

echo "pre-push: tests"
node --test > /dev/null
# The Python half is the token emitter's machinery. It runs here for the same
# reason the rest does, and it stays here because it is fast: unittest needs no
# install, like node --test.
# stdout is the module under test printing its reports; the verdict is on
# stderr, and the exit code is what the hook actually depends on.
python3 -m unittest discover -q -s test -p 'test_*.py' > /dev/null

echo "pre-push: ok"
